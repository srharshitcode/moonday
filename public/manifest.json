{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "MoonDay Tracker",
  "short_name": "MoonDay",
  "description": "Your cycle. Your space. Your story.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#fff8fa",
  "theme_color": "#a55f78",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png"
    }
  ]
}